{
  "name": "tabword",
  "displayName": "Tabword",
  "description": "Two-stage word completion with compact, cursor-local suggestions.",
  "version": "0.2.4",
  "publisher": "archaison-commits",
  "repository": {
    "type": "git",
    "url": "https://github.com/archaison-commits/Tabword.git"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Programming Languages"
  ],
  "keywords": [
    "word completion",
    "tab completion",
    "terminal",
    "productivity",
    "VS Code"
  ],
  "icon": "images/tabword-icon.png",
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "tabword.expand",
        "title": "Tabword: Complete Next"
      },
      {
        "command": "tabword.expandPrevious",
        "title": "Tabword: Complete Previous"
      },
      {
        "command": "tabword.dismissSuggestions",
        "title": "Tabword: Dismiss Suggestions"
      }
    ],
    "keybindings": [
      {
        "key": "tab",
        "command": "tabword.expand",
        "when": "editorTextFocus && tabword.canComplete && !suggestWidgetVisible"
      },
      {
        "key": "shift+tab",
        "command": "tabword.expandPrevious",
        "when": "editorTextFocus && tabword.canComplete && !suggestWidgetVisible"
      },
      {
        "key": "tab",
        "command": "acceptSelectedSuggestion",
        "when": "editorTextFocus && suggestWidgetVisible && tabword.suggestionsVisible"
      },
      {
        "key": "escape",
        "command": "tabword.dismissSuggestions",
        "when": "editorTextFocus && suggestWidgetVisible && tabword.suggestionsVisible"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^5.3.3"
  }
}
